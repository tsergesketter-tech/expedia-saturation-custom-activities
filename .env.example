# Copy to ~/expedia-mce.env (read by deploy/deploy.sh and deploy/mce.py). Never commit real values.
# Marketing Cloud Engagement installed package (server-to-server) + target BU
MCE_CLIENT_ID=''
MCE_CLIENT_SECRET=''
MCE_AUTH_BASE_URL='https://<subdomain>.auth.marketingcloudapis.com/'
MCE_REST_BASE_URL='https://<subdomain>.rest.marketingcloudapis.com/'
MCE_ACCOUNT_ID=''                      # BU MID
# Journey Builder custom activity
MCE_JWT_SECRET=''                      # installed package "JWT Signing Secret"
MCE_CA_SYNC_KEY=''                     # Journey Builder Activity component unique key (sync)
MCE_CA_ASYNC_KEY=''                    # Journey Builder Activity component unique key (async)
MCE_EVENT_DEFINITION_KEY=''            # API Event entry source key
MCE_IMPORT_AUTOMATION_KEY=''           # optional: S3 -> DE import automation
# Databricks (optional sink); token is read from ~/.expedia-sat/dbx_pat
DBX_HOST='adb-<workspace>.azuredatabricks.net'
DBX_WAREHOUSE_ID=''
SEED_EMAIL='you@example.com'
